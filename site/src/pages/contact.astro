---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { ENTITY, APP_LINKS } from '@/data/entity';
import { breadcrumbs } from '@/lib/schema';

const title = 'Contact AssetMX';
const description = 'Questions about low-doc asset finance or an application in progress? Email info@assetmx.com.au or send a message. We reply within a few hours, Monday to Friday.';
const subjects = ['General enquiry', 'Finance application help', 'Quote question', 'Existing application', 'Novated lease (millarX referral)', 'Partnership enquiry', 'Other'];
const schema = [
  breadcrumbs([{ name: 'Home', url: ENTITY.siteUrl + '/' }, { name: 'Contact', url: ENTITY.siteUrl + '/contact' }]),
  { '@type': 'ContactPoint', contactType: 'customer service', email: ENTITY.email, areaServed: 'AU', availableLanguage: 'en' },
];
---
<Base title={title} description={description} path="/contact" pageType="ContactPage" schema={schema}>
  <section class="container-x pt-8">
    <Breadcrumbs items={[{ name: 'Contact', href: '/contact' }]} />
    <p class="eyebrow mt-6">Contact</p>
    <h1 class="mt-2">Get in touch</h1>
    <p class="mt-4 text-lg text-ink-600 max-w-2xl">Questions about finance, or help with an application? We are a digital-first platform, so email is fastest.</p>
  </section>

  <section class="container-x mt-10 grid gap-8 lg:grid-cols-[1fr_1.2fr] lg:items-start">
    <div class="space-y-4">
      <div class="card p-5">
        <p class="eyebrow">Email</p>
        <a href={`mailto:${ENTITY.email}`} class="mt-1 block text-lg font-semibold text-ink no-underline">{ENTITY.email}</a>
        <p class="text-sm text-ink-500">Usually within a few hours, Monday to Friday, 9am to 5pm AEST.</p>
      </div>
      <div class="card p-5">
        <p class="eyebrow">Phone</p>
        <p class="mt-1 font-semibold text-ink">Coming soon</p>
        <p class="text-sm text-ink-500">Phone support is on the way. Until then, email or the form reaches a person.</p>
      </div>
      <div class="card p-5 text-sm">
        <p class="eyebrow">Quick links</p>
        <ul class="mt-2 space-y-1.5">
          <li><a href={APP_LINKS.quote} class="underline">Start a finance application</a></li>
          <li><a href="/how-we-compare" class="underline">How we compare to brokers</a></li>
          <li><a href="/credit-guide" class="underline">Read our Credit Guide</a></li>
          <li><a href="/lender-policies" class="underline">Lender low-doc policies</a></li>
        </ul>
      </div>
      <p class="text-xs text-ink-500">{ENTITY.brand} is a trading name of {ENTITY.legalName}, ABN {ENTITY.abn}, Australian Credit Licence {ENTITY.acl}.</p>
    </div>

    <div class="card p-6">
      <h2 class="text-xl">Send us a message</h2>
      <!-- Netlify Forms: static HTML, no client JS. Submissions appear in the Netlify dashboard and can notify info@assetmx.com.au. -->
      <form name="contact" method="POST" action="/contact-thanks" data-netlify="true" netlify-honeypot="company" class="mt-5 grid gap-4">
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden"><label>Leave this empty <input name="company" /></label></p>
        <label class="grid gap-1 text-sm font-medium">Name<input name="name" required autocomplete="name" class="rounded-card border border-ink-200 px-3 py-2 font-normal focus:border-signal focus:outline-none" /></label>
        <label class="grid gap-1 text-sm font-medium">Email<input name="email" type="email" required autocomplete="email" class="rounded-card border border-ink-200 px-3 py-2 font-normal focus:border-signal focus:outline-none" /></label>
        <label class="grid gap-1 text-sm font-medium">Phone <span class="text-ink-400 font-normal">(optional)</span><input name="phone" type="tel" autocomplete="tel" class="rounded-card border border-ink-200 px-3 py-2 font-normal focus:border-signal focus:outline-none" /></label>
        <label class="grid gap-1 text-sm font-medium">Subject
          <select name="subject" required class="rounded-card border border-ink-200 px-3 py-2 font-normal bg-white focus:border-signal focus:outline-none">
            <option value="">Select a topic</option>
            {subjects.map((s) => <option value={s}>{s}</option>)}
          </select>
        </label>
        <label class="grid gap-1 text-sm font-medium">Message<textarea name="message" rows="5" required class="rounded-card border border-ink-200 px-3 py-2 font-normal focus:border-signal focus:outline-none"></textarea></label>
        <button type="submit" class="btn-primary">Send message</button>
        <p class="text-xs text-ink-500">Or email us directly at <a href={`mailto:${ENTITY.email}`} class="underline">{ENTITY.email}</a>. We use your details only to reply. See our <a href="/privacy" class="underline">privacy policy</a>.</p>
      </form>
    </div>
  </section>
</Base>
