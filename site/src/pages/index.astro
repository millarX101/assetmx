---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import QuickStart from '@/islands/QuickStart';
import QuoteCalculator from '@/islands/QuoteCalculator';
import Faq from '@/components/Faq.astro';
import Cta from '@/components/Cta.astro';
import RateTable from '@/components/RateTable.astro';
import { ENTITY, PRICING, APP_LINKS, money, pct, longDate } from '@/data/entity';
import { RATES, lowestRate } from '@/data/rates';
import { calculateQuote } from '@/lib/calculator';
import { faqPage, offerCatalog } from '@/lib/schema';
import { img } from '@/lib/images';

const title = 'AssetMX | Finance the gear. Skip the broker. $800 flat fee asset finance';
const description = `Transparent vehicle, truck and equipment finance for established Australian businesses. One flat $800 fee, no lender commission, lender base rate from ${pct(lowestRate())} p.a. Three questions to start.`;

const ex = calculateQuote({ amount: 100_000, termMonths: 60, balloonPct: 0 });

const products = [
  { eyebrow: 'Vehicle finance', title: 'Cars, utes and vans', body: 'Work utes, dual cabs, tradie vans, company cars and light commercials. Business-use vehicles for sole traders, partnerships, companies and trusts.', href: '/car-finance', image: 'hero-ranger.jpg', alt: 'Ford Ranger ute used for business' },
  { eyebrow: 'Truck finance', title: 'Trucks and trailers', body: 'Rigid trucks, tippers, refrigerated bodies, flat tops and trailers for transport, logistics, construction and agriculture operators.', href: '/truck-finance', image: 'hero-truck.jpg', alt: 'Isuzu rigid truck' },
  { eyebrow: 'Equipment finance', title: 'Machinery and equipment', body: 'Excavators, loaders, skid steers, forklifts, manufacturing equipment, fit-outs, agricultural and earthmoving machinery.', href: '/equipment-finance', image: 'hero-excavator.jpg', alt: 'Excavator on a construction site' },
];

const steps = [
  { n: '1', t: 'Three questions', d: 'Asset, amount, ABN. Takes under a minute, right here on this page.' },
  { n: '2', t: 'We pre-fill', d: 'Business name, entity type, GST status and trading history come from the Australian Business Register. You confirm, not type.' },
  { n: '3', t: 'Finish in chat', d: 'A short guided conversation covers the rest: the asset details, a few financials, your consent. Then it is with the lender.' },
];

const fit = [
  { t: 'Trading 2+ years', d: 'An active ABN with at least two years behind it, registered for GST.' },
  { t: 'Clean credit', d: 'No defaults or judgments on the business or its directors.' },
  { t: 'Vehicles, trucks or equipment', d: `Utes, trucks, trailers, excavators, machinery and the like, for business use, from ${money(PRICING.minAmount)} to ${money(PRICING.maxAmount)}.` },
];

const faqs = [
  { q: 'What is the AssetMX fee?', a: `One flat ${PRICING.platformFeeLabel} fee, disclosed before you apply. We do not take lender commission on top, so it is not built into your rate. It can be financed into the loan or paid upfront.` },
  { q: 'Who is eligible?', a: `Australian businesses with an active ABN trading for ${PRICING.minAbnMonths / 12} or more years, registered for GST, clean credit for the business and its directors, and an asset for business use such as a vehicle, truck, trailer or equipment.` },
  { q: 'What can I finance?', a: 'Cars, utes and vans; trucks and trailers; excavators, machinery, agricultural and manufacturing equipment, and other income-producing business assets. New or used, from a dealer or a private seller.' },
  { q: 'How long does the application take?', a: 'Three questions on this page take under a minute. Most of the remaining application is pre-filled from your ABN, and the guided chat usually finishes in about four minutes. Conditional approval for in-policy files is typically the same business day.' },
  { q: 'Is there a credit check when I start?', a: 'No. Nothing is checked against your credit file until you explicitly consent inside the application.' },
  { q: 'What rate will I pay?', a: `Indicative lender base rates are ${RATES.byTerm.map((r) => `${pct(r.ratePct)} over ${r.termMonths} months`).join(', ')}, verified ${longDate(RATES.verifiedOn)}. The lender sets your final rate on application. AssetMX adds nothing to it.` },
  { q: 'What is a chattel mortgage?', a: 'A business loan secured against the asset you are buying. You own the asset from day one, the lender holds a mortgage over it until the loan is repaid, and GST-registered businesses can usually claim the GST on the purchase price up front.' },
  { q: 'Do I need a deposit?', a: 'Not always. Depending on the asset, the lender and your trading history, finance can cover the full purchase price. A deposit or trade-in can lower your repayments.' },
];

const answers = (await getCollection('answers')).sort((a, b) => a.data.question.localeCompare(b.data.question)).slice(0, 6);
---
<Base title={title} description={description} path="/" schema={[faqPage(faqs), offerCatalog()]}>
  <!-- Hero -->
  <section class="container-x pt-12 pb-10 md:pt-16 grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-start">
    <div>
      <div class="flex flex-wrap gap-2">
        <span class="pill-sand">{PRICING.platformFeeLabel} flat fee</span>
        <span class="pill">No broker commission</span>
      </div>
      <h1 class="mt-5">Finance the gear.<br /><span class="text-forest">Skip the broker.</span></h1>
      <p class="mt-5 text-lg text-ink-700 max-w-lg">
        Transparent asset finance for established Australian businesses. Answer three questions and we pre-fill most of the application for you.
      </p>
      <dl class="mt-8 grid grid-cols-3 gap-4 max-w-md">
        <div><dt class="sr-only">Questions to start</dt><dd class="font-display text-3xl">3</dd><dd class="text-xs text-ink-600">questions to start</dd></div>
        <div><dt class="sr-only">Time to full application</dt><dd class="font-display text-3xl">~4 min</dd><dd class="text-xs text-ink-600">to a full application</dd></div>
        <div><dt class="sr-only">Total fee</dt><dd class="font-display text-3xl">{PRICING.platformFeeLabel}</dd><dd class="text-xs text-ink-600">total fee, disclosed up front</dd></div>
      </dl>
    </div>
    <QuickStart client:load />
  </section>

  <!-- How it works -->
  <section class="band-forest mt-10 py-16">
    <div class="container-x">
      <h2>Most of the form fills itself.</h2>
      <p class="mt-3 max-w-xl text-ink-200">You give us three answers. We do the data entry, then ask only what we can't look up.</p>
      <ol class="mt-10 grid gap-8 md:grid-cols-3">
        {steps.map((s) => (
          <li>
            <span class="step-badge">{s.n}</span>
            <h3 class="mt-4">{s.t}</h3>
            <p class="mt-2 text-sm text-ink-200 leading-relaxed">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- The fee -->
  <section id="fee" class="container-x mt-20 grid gap-10 md:grid-cols-[1fr_1fr] md:items-center scroll-mt-24">
    <div>
      <h2>One fee. Written down before you start.</h2>
      <p class="mt-4 text-ink-700">
        Brokers are usually paid by the lender, and that cost sits inside your rate where you can't see it.
        We charge {PRICING.platformFeeLabel}, we tell you first, and we don't take commission on top.
      </p>
      <p class="mt-3 text-sm text-ink-600">On {money(100_000)} over five years at the same {pct(ex.ratePct)} lender rate, a typical {pct(PRICING.typicalBrokerMarginPct, 0)} loading costs about <span class="num font-semibold text-ink">{money(ex.saving)}</span> more. <a href="/how-we-compare" class="underline">See the comparison</a>.</p>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div class="card-sand p-6">
        <p class="eyebrow">Typical broker</p>
        <p class="font-display text-3xl mt-3">Undisclosed</p>
        <p class="mt-2 text-sm text-ink-700">Commission built into the rate. You rarely see the number.</p>
      </div>
      <div class="rounded-card bg-sage-100 border border-sage-200 p-6">
        <p class="eyebrow text-forest">AssetMX</p>
        <p class="font-display text-3xl mt-3">{PRICING.platformFeeLabel}</p>
        <p class="mt-2 text-sm text-ink-700">Flat fee, disclosed up front. Nothing else from us.</p>
      </div>
    </div>
  </section>

  <!-- Who it's for -->
  <section id="fit" class="band-sage mt-20 py-16 scroll-mt-24">
    <div class="container-x grid gap-10 md:grid-cols-[1fr_1.2fr] md:items-start">
      <div>
        <h2>Built for businesses that already work.</h2>
        <p class="mt-4 text-ink-700 max-w-sm">We keep the process short by only taking on straightforward files. If this is you, you'll move quickly. If not, we say so in the first minute.</p>
        <p class="mt-4 text-sm"><a href="/lender-policies" class="underline">Lender low-doc policies in detail</a></p>
      </div>
      <ul class="grid gap-3">
        {fit.map((f) => (
          <li class="card p-5 flex gap-4">
            <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-forest text-canvas text-sm" aria-hidden="true">✓</span>
            <div>
              <p class="font-semibold text-ink">{f.t}</p>
              <p class="mt-1 text-sm text-ink-700">{f.d}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- What we finance -->
  <section class="container-x mt-20">
    <h2>What we finance</h2>
    <p class="mt-3 text-ink-700 max-w-2xl">Income-producing assets for Australian businesses, new or used, from a dealer or a private seller. Most files are written as a chattel mortgage, so you own the asset from day one.</p>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {products.map((p) => (
        <a href={p.href} class="card overflow-hidden no-underline group">
          <Image src={img(p.image)} alt={p.alt} width={640} height={420} class="h-44 w-full object-cover group-hover:opacity-95" loading="lazy" />
          <div class="p-5">
            <p class="eyebrow">{p.eyebrow}</p>
            <h3 class="mt-1">{p.title}</h3>
            <p class="mt-2 text-sm text-ink-700">{p.body}</p>
          </div>
        </a>
      ))}
    </div>
    <p class="mt-4 text-sm text-ink-600">Electric vehicles for business are financed the same way. <a href="/ev-leasing" class="underline">EV finance</a>.</p>
  </section>

  <!-- Rate + quote -->
  <section id="quote" class="container-x mt-20 grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-start scroll-mt-24">
    <div>
      <h2>See your real rate before you give us a single detail.</h2>
      <p class="mt-4 text-ink-700">The lender base rate, our {PRICING.platformFeeLabel}, and the total cost of credit, side by side with the same deal through a typical broker. Every rate on this site carries the date it was verified.</p>
      <div class="mt-6"><RateTable compact /></div>
    </div>
    <QuoteCalculator client:visible />
  </section>

  <!-- FAQ -->
  <div class="container-x">
    <Faq items={faqs} intro="Straight answers about the fee, eligibility and how a business asset loan actually works." />
  </div>

  <!-- Answers -->
  <section class="container-x mt-20">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Plain answers</p>
        <h2 class="mt-2">More questions business owners ask</h2>
      </div>
      <a href="/answers" class="btn-ghost hidden sm:inline-flex">All answers</a>
    </div>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {answers.map((a) => (
        <li class="card p-5">
          <a href={`/answers/${a.id}`} class="no-underline">
            <p class="font-semibold text-ink">{a.data.question}</p>
            <p class="mt-2 text-sm text-ink-700 line-clamp-3">{a.data.shortAnswer}</p>
          </a>
        </li>
      ))}
    </ul>
    <a href="/answers" class="btn-ghost mt-6 sm:hidden">All answers</a>
  </section>

  <!-- About -->
  <section class="mt-20 bg-sand py-16">
    <div class="container-x grid gap-8 md:grid-cols-[1fr_2fr]">
      <h2>About AssetMX</h2>
      <div class="prose-mx">
        <p>
          AssetMX is the asset finance arm of {ENTITY.legalName} (Australian Credit Licence {ENTITY.acl}). We arrange vehicle, truck and equipment finance for established Australian small and medium businesses, and we charge one flat {PRICING.platformFeeLabel} fee instead of taking a lender commission. Because the fee is fixed, there is no reason for us to steer you toward a higher rate or a longer term.
        </p>
        <p>
          We keep the process short by working with straightforward files: businesses trading two or more years, with clean credit, buying assets for business use. Applications start with three questions on this page, are pre-filled from the Australian Business Register, and finish in a short guided chat. Nothing touches your credit file until you say so.
        </p>
      </div>
    </div>
  </section>

  <div class="container-x"><Cta /></div>
</Base>
