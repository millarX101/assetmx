---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import QuoteCalculator from '@/islands/QuoteCalculator';
import Faq from '@/components/Faq.astro';
import Cta from '@/components/Cta.astro';
import RateTable from '@/components/RateTable.astro';
import { ENTITY, PRICING, APP_LINKS, money, pct, longDate } from '@/data/entity';
import { RATES, lowestRate } from '@/data/rates';
import { calculateQuote } from '@/lib/calculator';
import { faqPage, offerCatalog } from '@/lib/schema';
import { img } from '@/lib/images';

const title = 'AssetMX | Low-doc asset finance, $800 flat fee, no hidden commission';
const description = `Self-serve low-doc asset finance for ABN businesses trading 24+ months. Lender base rate from ${pct(lowestRate())} p.a. shown separately plus a flat $800 fee. Quote in about 60 seconds.`;

// Worked example computed by the same engine as the quote island.
const ex = calculateQuote({ amount: 100_000, termMonths: 60, balloonPct: 0 });

const products = [
  { title: 'Cars, utes and vans', sub: 'Ranger, Hilux, Transit, Sprinter', href: '/car-finance', image: 'hero-ranger.jpg', alt: 'Ford Ranger ute used for business' },
  { title: 'Trucks and light commercials', sub: 'Isuzu, Hino, Fuso, cab chassis', href: '/truck-finance', image: 'hero-truck.jpg', alt: 'Isuzu rigid truck' },
  { title: 'Equipment and machinery', sub: 'Excavators, loaders, earthmoving', href: '/equipment-finance', image: 'hero-excavator.jpg', alt: 'Excavator on a construction site' },
  { title: 'Electric vehicles', sub: 'Tesla, BYD, European EVs', href: '/ev-leasing', image: 'hero-ev.jpg', alt: 'Tesla Model 3 electric vehicle' },
];

const steps = [
  { n: '1', t: 'Quote in about 60 seconds', d: 'Set the amount, term and balloon. You see the lender base rate, our flat fee and the total cost before you give us a single detail.' },
  { n: '2', t: 'Check your fit', d: 'We look up your ABN and GST status automatically and tell you straight away if you fit bank low-doc policy. No credit check yet.' },
  { n: '3', t: 'Upload, sign, settle', d: 'Driver licence, bank statements and the invoice. Our system reads them, flags gaps, and prepares the lender file. Conditional approval is typically same business day.' },
];

const fit = [
  { ok: true, t: 'ABN active for 24 months or more' },
  { ok: true, t: 'Registered for GST' },
  { ok: true, t: `Financing ${money(PRICING.minAmount)} to ${money(PRICING.maxAmount)} of business-use assets` },
  { ok: true, t: 'Directors with a clean credit history' },
  { ok: false, t: 'New ABNs, non-GST businesses, or complex deals that need a relationship manager. A traditional broker will suit you better.' },
];

const faqs = [
  { q: 'What does AssetMX charge?', a: `A flat ${PRICING.platformFeeLabel} fee, shown separately from the lender's base rate. It can be financed into the loan or paid upfront. There is no commission built into your interest rate.` },
  { q: 'What is low-doc asset finance?', a: 'Finance for a business asset where the lender approves on ABN age, GST registration, credit history and bank statements rather than full financial statements and tax returns. It suits established businesses buying vehicles, trucks and equipment.' },
  { q: 'Who is eligible?', a: `Businesses with an ABN active for at least ${PRICING.minAbnMonths} months, registered for GST, financing between ${money(PRICING.minAmount)} and ${money(PRICING.maxAmount)}, with an asset no older than ${PRICING.maxAssetAgeAtTermEnd} years at the end of the term.` },
  { q: 'What rate will I pay?', a: `Indicative lender base rates are ${RATES.byTerm.map((r) => `${pct(r.ratePct)} for ${r.termMonths} months`).join(', ')}, verified ${longDate(RATES.verifiedOn)}. The lender sets your final rate after a formal application. AssetMX adds no margin.` },
  { q: 'How fast is approval?', a: 'The online quote is instant. Conditional approval for in-policy low-doc applications is typically the same business day, and settlement usually follows within one to two business days of the signed documents and invoice arriving.' },
  { q: 'Does getting a quote affect my credit score?', a: 'No. A quote on this site runs no credit enquiry. Lenders only check the business and directors once you submit a formal application.' },
];

const answers = (await getCollection('answers'))
  .sort((a, b) => a.data.question.localeCompare(b.data.question))
  .slice(0, 6);
---
<Base title={title} description={description} path="/" schema={[faqPage(faqs), offerCatalog()]}>
  <!-- Hero + quote island -->
  <section class="container-x pt-14 pb-10 md:pt-20 grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-start">
    <div>
      <p class="eyebrow">Low-doc asset finance for established businesses</p>
      <h1 class="mt-3">
        {PRICING.platformFeeLabel} flat.<br />
        <span class="text-signal-700">Lender rate shown separately.</span>
      </h1>
      <p class="mt-5 text-lg text-ink-600 max-w-xl">
        No commission hidden in your rate. No phone tag. Quote, check your fit and apply online for cars, trucks and equipment
        from {money(PRICING.minAmount)} to {money(PRICING.maxAmount)}.
      </p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-3 text-sm">
        <li class="card p-4">
          <p class="num text-2xl font-semibold">{pct(lowestRate())}</p>
          <p class="text-ink-500">lender base rate p.a. from, 36 to 60 months</p>
        </li>
        <li class="card p-4">
          <p class="num text-2xl font-semibold">{PRICING.platformFeeLabel}</p>
          <p class="text-ink-500">our entire fee, on any size deal</p>
        </li>
        <li class="card p-4">
          <p class="num text-2xl font-semibold">24 mo</p>
          <p class="text-ink-500">minimum ABN age, GST registered</p>
        </li>
      </ul>
      <p class="mt-4 text-xs text-ink-500">Rates verified {longDate(RATES.verifiedOn)}. Indicative, set by the lender on application.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#quote" class="btn-primary">Get a quote</a>
        <a href="/lender-policies" class="btn-ghost">Check lender policy</a>
      </div>
    </div>
    <QuoteCalculator client:visible />
  </section>

  <!-- Fit check -->
  <section class="container-x mt-12 grid gap-8 md:grid-cols-[1fr_1fr]">
    <div>
      <p class="eyebrow">Is it for you?</p>
      <h2 class="mt-2">Built for businesses that fit bank low-doc policy</h2>
      <p class="mt-3 text-ink-600">
        Good businesses with clean credit were paying the same loaded rates as everyone else. We built a straight-through
        process for the ones that fit policy, and we tell you within a minute if you do not.
      </p>
    </div>
    <ul class="card divide-y divide-ink-100">
      {fit.map((f) => (
        <li class="flex gap-3 px-5 py-3 text-sm">
          <span class:list={['mt-0.5 shrink-0 h-5 w-5 rounded-full inline-flex items-center justify-center text-xs font-bold', f.ok ? 'bg-signal-100 text-signal-700' : 'bg-ink-100 text-ink-500']} aria-hidden="true">{f.ok ? '✓' : '–'}</span>
          <span class={f.ok ? 'text-ink' : 'text-ink-600'}>{f.t}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Products -->
  <section class="container-x mt-20">
    <p class="eyebrow">What we finance</p>
    <h2 class="mt-2">Same {PRICING.platformFeeLabel} fee across every asset type</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {products.map((p) => (
        <a href={p.href} class="card overflow-hidden no-underline group">
          <Image src={img(p.image)} alt={p.alt} width={640} height={420} class="h-40 w-full object-cover group-hover:opacity-95" loading="lazy" />
          <div class="p-4">
            <p class="font-semibold text-ink">{p.title}</p>
            <p class="text-sm text-ink-500">{p.sub}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- How it works -->
  <section class="container-x mt-20">
    <p class="eyebrow">How it works</p>
    <h2 class="mt-2">Cold visitor to qualified application in minutes, not weeks</h2>
    <ol class="mt-8 grid gap-5 md:grid-cols-3">
      {steps.map((s) => (
        <li class="card p-6">
          <span class="num inline-flex h-8 w-8 items-center justify-center rounded-full bg-ink text-white text-sm font-semibold">{s.n}</span>
          <h3 class="mt-4">{s.t}</h3>
          <p class="mt-2 text-sm text-ink-600">{s.d}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Worked example -->
  <section class="container-x mt-20">
    <p class="eyebrow">The difference, on real numbers</p>
    <h2 class="mt-2">{money(100_000)} over 5 years, same lender rate</h2>
    <p class="mt-3 text-ink-600 max-w-2xl">
      Brokers typically build about {PRICING.typicalBrokerMarginPct.toFixed(0)}% commission into the rate you are shown. We show the lender base
      rate and charge {PRICING.platformFeeLabel} separately. Both columns below are calculated by the same engine as the quote tool, at {pct(ex.ratePct)} verified {longDate(RATES.verifiedOn)}.
    </p>
    <div class="mt-8 table-wrap">
      <table>
        <thead>
          <tr><th scope="col">Line item</th><th scope="col">Typical broker</th><th scope="col">AssetMX</th></tr>
        </thead>
        <tbody>
          <tr><td>Lender base rate</td><td class="num">{pct(ex.ratePct)}</td><td class="num">{pct(ex.ratePct)}</td></tr>
          <tr><td>Rate you are shown</td><td class="num">{pct(ex.brokerRatePct)}</td><td class="num font-semibold">{pct(ex.ratePct)}</td></tr>
          <tr><td>Fee disclosed to you</td><td class="num">$0 (commission in the rate)</td><td class="num font-semibold">{money(PRICING.platformFee)}</td></tr>
          <tr><td>Monthly repayment</td><td class="num">{money(ex.brokerMonthly, 2)}</td><td class="num font-semibold">{money(ex.monthly, 2)}</td></tr>
          <tr><td>Total cost of credit</td><td class="num">{money(ex.brokerTotalCost)}</td><td class="num font-semibold">{money(ex.totalCost)}</td></tr>
          <tr><td class="font-semibold text-ink">Difference over the term</td><td></td><td class="num font-semibold text-signal-700">{money(ex.saving)} less</td></tr>
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-ink-500">
      Assumes a {pct(PRICING.typicalBrokerMarginPct, 0)} broker rate loading, {money(PRICING.lenderEstablishmentFee)} lender establishment fee financed in both cases, no balloon, repayments in advance. Your figures will differ.
      <a href="/how-we-compare" class="underline">Full comparison</a>.
    </p>
  </section>

  <!-- Rates -->
  <section class="container-x mt-20 grid gap-8 md:grid-cols-[1fr_1.4fr] md:items-start">
    <div>
      <p class="eyebrow">Current lender base rates</p>
      <h2 class="mt-2">Dated, sourced, no margin added</h2>
      <p class="mt-3 text-ink-600">Every rate on this site carries the date it was verified. If a rate is old, you will see that it is old. <a href="/rates" class="underline">Rates page</a>.</p>
    </div>
    <RateTable />
  </section>

  <!-- Answers -->
  <section class="container-x mt-20">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Plain answers</p>
        <h2 class="mt-2">Questions business owners actually ask</h2>
      </div>
      <a href="/answers" class="btn-ghost hidden sm:inline-flex">All answers</a>
    </div>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {answers.map((a) => (
        <li class="card p-5">
          <a href={`/answers/${a.id}`} class="no-underline">
            <p class="font-semibold text-ink">{a.data.question}</p>
            <p class="mt-2 text-sm text-ink-600 line-clamp-3">{a.data.shortAnswer}</p>
          </a>
        </li>
      ))}
    </ul>
    <a href="/answers" class="btn-ghost mt-6 sm:hidden">All answers</a>
  </section>

  <!-- Story -->
  <section class="container-x mt-20 grid gap-8 md:grid-cols-[1fr_1.4fr]">
    <div>
      <p class="eyebrow">Our story</p>
      <h2 class="mt-2">Twenty years of watching good businesses subsidise bad deals</h2>
    </div>
    <div class="prose-mx">
      <p>
        From helping thousands of business clients over the past two decades, we identified a largely untouched part of the
        market that suffers through traditional channels. Good businesses with clean credit were paying the same rates as
        everyone else, subsidising higher-risk borrowers through opaque broker margins.
      </p>
      <p>
        We are redefining how easy lending should be for great business clients. We built this system from the ground up,
        Australian owned and run, to benefit Australian businesses. {ENTITY.brand} is a trading name of {ENTITY.legalName},
        holder of Australian Credit Licence {ENTITY.acl}.
      </p>
    </div>
  </section>

  <div class="container-x">
    <Faq items={faqs} />
    <Cta />
  </div>
</Base>
