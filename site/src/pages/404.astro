---
import Base from '@/layouts/Base.astro';
---
<Base title="Page not found" description="That page does not exist on AssetMX." path="/404" noindex>
  <section class="container-x py-24 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-2">That page is not here</h1>
    <p class="mt-4 text-ink-600">Try the <a href="/answers" class="underline">answers</a>, the <a href="/rates" class="underline">rates</a>, or go <a href="/" class="underline">home</a>.</p>
  </section>
</Base>
