---
import { APP_LINKS } from '@/data/entity';
import Logo from '@/components/Logo.astro';

const products = [
  { label: 'Car finance', href: '/car-finance', hint: 'Utes, vans, cars, 4WDs' },
  { label: 'Truck & van finance', href: '/truck-finance', hint: 'Rigid and light trucks' },
  { label: 'Equipment finance', href: '/equipment-finance', hint: 'Excavators, loaders, plant' },
  { label: 'EV finance', href: '/ev-leasing', hint: 'Business EVs and novated referrals' },
];
const learn = [
  { label: 'Answers', href: '/answers', hint: '20 plain-English answers' },
  { label: 'Current rates', href: '/rates', hint: 'Dated lender base rates' },
  { label: 'Lender low-doc policies', href: '/lender-policies', hint: 'Reviewed monthly' },
  { label: 'How we compare', href: '/how-we-compare', hint: 'AssetMX vs a broker' },
  { label: 'Guides', href: '/guides', hint: 'Long-form explainers' },
];
const current = Astro.url.pathname;
const isActive = (href: string) => current === href || current.startsWith(href + '/');
---
<header class="sticky top-0 z-40 border-b border-ink-200 bg-white/90 backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between gap-6">
    <a href="/" class="flex items-center no-underline" aria-label="AssetMX home">
      <Logo />
    </a>

    <nav class="hidden md:flex items-center gap-1 text-sm font-medium" aria-label="Primary">
      <div class="group relative">
        <button class="px-3 py-2 rounded-card text-ink-700 hover:text-ink hover:bg-ink-50 flex items-center gap-1" aria-haspopup="true">
          Finance <span aria-hidden="true" class="text-ink-400">▾</span>
        </button>
        <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition absolute left-0 top-full pt-2 w-72">
          <ul class="card p-2">
            {products.map((p) => (
              <li>
                <a href={p.href} class="block rounded-lg px-3 py-2 no-underline hover:bg-ink-50">
                  <span class="block text-ink font-semibold">{p.label}</span>
                  <span class="block text-xs text-ink-500">{p.hint}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="group relative">
        <button class="px-3 py-2 rounded-card text-ink-700 hover:text-ink hover:bg-ink-50 flex items-center gap-1" aria-haspopup="true">
          Learn <span aria-hidden="true" class="text-ink-400">▾</span>
        </button>
        <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition absolute left-0 top-full pt-2 w-72">
          <ul class="card p-2">
            {learn.map((p) => (
              <li>
                <a href={p.href} class="block rounded-lg px-3 py-2 no-underline hover:bg-ink-50">
                  <span class="block text-ink font-semibold">{p.label}</span>
                  <span class="block text-xs text-ink-500">{p.hint}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <a href="/rates" class:list={['px-3 py-2 rounded-card no-underline hover:bg-ink-50', isActive('/rates') ? 'text-ink' : 'text-ink-700']}>Rates</a>
      <a href="/how-we-compare" class:list={['px-3 py-2 rounded-card no-underline hover:bg-ink-50', isActive('/how-we-compare') ? 'text-ink' : 'text-ink-700']}>Compare</a>
      <a href="/contact" class:list={['px-3 py-2 rounded-card no-underline hover:bg-ink-50', isActive('/contact') ? 'text-ink' : 'text-ink-700']}>Contact</a>
    </nav>

    <div class="hidden md:flex items-center gap-2">
      <a href={APP_LINKS.admin} class="btn-ghost py-2" rel="nofollow">Log in</a>
      <a href="/#quote" class="btn-primary py-2">Get a quote</a>
    </div>

    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer btn-ghost py-2 px-3" aria-label="Open menu">Menu</summary>
      <div class="absolute right-0 top-full mt-2 w-[calc(100vw-2.5rem)] max-w-sm card p-3 text-sm">
        <p class="eyebrow px-2 pt-1">Finance</p>
        <ul class="mb-2">{products.map((p) => <li><a href={p.href} class="block px-2 py-2 no-underline text-ink font-medium">{p.label}</a></li>)}</ul>
        <p class="eyebrow px-2 pt-1">Learn</p>
        <ul class="mb-2">{learn.map((p) => <li><a href={p.href} class="block px-2 py-2 no-underline text-ink font-medium">{p.label}</a></li>)}</ul>
        <ul class="mb-3 border-t border-ink-100 pt-2">
          <li><a href="/contact" class="block px-2 py-2 no-underline text-ink font-medium">Contact</a></li>
          <li><a href={APP_LINKS.admin} class="block px-2 py-2 no-underline text-ink-600" rel="nofollow">Log in</a></li>
        </ul>
        <a href="/#quote" class="btn-primary w-full">Get a quote</a>
      </div>
    </details>
  </div>
</header>
