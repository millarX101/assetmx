---
/**
 * Renders Q&A as native <details>. The matching FAQPage JSON-LD is emitted
 * by the page (via schema.faqPage) so the markup and the schema share one source.
 */
interface Props { items: { q: string; a: string }[]; title?: string; class?: string }
const { items, title = 'Frequently asked questions', class: cls = '' } = Astro.props;
---
<section class:list={['mt-14', cls]} aria-labelledby="faq-heading">
  <h2 id="faq-heading">{title}</h2>
  <div class="mt-6 divide-y divide-ink-200 rounded-card border border-ink-200 bg-paper">
    {items.map((f) => (
      <details class="group px-5 py-4">
        <summary class="cursor-pointer list-none flex items-start justify-between gap-4 font-semibold text-ink">
          <span>{f.q}</span>
          <span aria-hidden="true" class="mt-0.5 text-ink-400 group-open:rotate-45 transition-transform">+</span>
        </summary>
        <p class="mt-3 text-ink-700 leading-relaxed" set:html={f.a} />
      </details>
    ))}
  </div>
</section>
