---
interface Props { facts: { label: string; value: string }[]; title?: string }
const { facts, title = 'Key facts' } = Astro.props;
---
{facts.length > 0 && (
  <aside class="card p-5" aria-label={title}>
    <p class="eyebrow">{title}</p>
    <dl class="mt-3 divide-y divide-ink-100">
      {facts.map((f) => (
        <div class="flex justify-between gap-4 py-2 text-sm">
          <dt class="text-ink-600">{f.label}</dt>
          <dd class="num font-semibold text-ink text-right">{f.value}</dd>
        </div>
      ))}
    </dl>
  </aside>
)}
