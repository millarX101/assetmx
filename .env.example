# AssetMX Environment Variables
# Copy this to .env.local for local development

# Supabase - Get from your project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Site URL (for OAuth redirects)
VITE_SITE_URL=http://localhost:5173

# Feature flags
VITE_ENABLE_AI_CHAT=false
VITE_ENABLE_DOCUMENT_AI=false

# Sentry (optional)
# VITE_SENTRY_DSN=your-sentry-dsn

# ---------------------------------------------------------------------------
# FLWUP lead sync — these are EDGE FUNCTION secrets, not VITE_ vars.
# Never put the FLWUP key in this file or any VITE_ variable: it would ship in
# the browser bundle. Set them with:
#   npx supabase secrets set FLWUP_API_KEY=flwup_live_... FLWUP_HOOK_SECRET=<random>
# See supabase/functions/flwup-sync/README.md
# ---------------------------------------------------------------------------
